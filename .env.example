# .env.example

# production, development
EXPO_PUBLIC_ENV=production

# Base URL for your API
# All auth and storage (Supabase or otherwise) is handled by the backend —
# the frontend never talks to Supabase directly and never holds its keys.
EXPO_PUBLIC_API_BASE_URL=

# none, error, warn, info, debug
EXPO_PUBLIC_LOG_LEVEL=

# Firebase Web SDK config — used ONLY on the web platform (src/services/firebaseWebConfig.js)
# to obtain an FCM token and receive push notifications via the browser.
# Native (Android/iOS) push does NOT use these — it relies on expo-notifications +
# google-services.json / GoogleService-Info.plist bundled into the EAS build instead.
# Firebase Console → Project Settings → General → "Your apps" → Web app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Firebase Console → Project Settings → Cloud Messaging → "Web Push certificates".
EXPO_PUBLIC_FIREBASE_VAPID_KEY=