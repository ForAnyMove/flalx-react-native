{
  "expo": {
    "name": "Flalx",
    "slug": "flalx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/flalx-logo-large.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/logo/preview-logo.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yulab.flalx",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "LSApplicationQueriesSchemes": ["whatsapp"]
      }
    },
    "android": {
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/flalx-logo-large.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.yulab.flalx",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/logo/favicon.png",
      "name": "Flalx - Professional Services",
      "shortName": "Flalx",
      "description": "Flalx is a platform that connects users with professional services easily and efficiently."
    },
    "extra": {
      "eas": {
        "projectId": "3b752486-12ec-41fc-93e6-c32197197fd4"
      }
    },
    "owner": "yulab",
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#ffffff",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-secure-store"
    ]
  }
}
